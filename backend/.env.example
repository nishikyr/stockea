DATABASE_URL=postgres://stockea:stockea@localhost:5433/stockea?sslmode=disable
PORT=8080
# "production" activa cookies solo-HTTPS
APP_ENV=development
# Carpeta donde se guardan las fotos de los productos
UPLOAD_DIR=./uploads
# Carpeta del frontend compilado (npm run build → frontend/dist). Vacío = Go no lo sirve
# (en desarrollo lo sirve Vite en :5173). Para probar "como en producción": STATIC_DIR=../frontend/dist
STATIC_DIR=

# --- Fotos en un almacenamiento S3 (producción). Si S3_BUCKET está vacío, se usan las carpetas de UPLOAD_DIR.
# Ejemplo con Neon Object Storage (los valores reales van en los secretos de la plataforma, NUNCA aquí):
#   S3_ENDPOINT=https://br-xxxx.storage.c-7.eu-central-1.aws.neon.tech
#   S3_REGION=eu-central-1
#   S3_BUCKET=stockea-photos
#   S3_ACCESS_KEY_ID=nak_live_...
#   S3_SECRET_ACCESS_KEY=nsk_live_...
S3_BUCKET=
# Espacio máximo para TODAS las fotos, en MB (freno de costes). 4096 = 4 GB de los 5 GB gratis de Neon
PHOTO_QUOTA_MB=4096
